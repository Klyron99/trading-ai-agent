# ============================================================
# trading_ai_agent — Variables d'environnement
# Copiez ce fichier en .env et remplissez vos valeurs.
# NE JAMAIS commiter le fichier .env dans git.
# ============================================================

# --- Général ---
ENV=development           # development | production
LOG_LEVEL=INFO            # DEBUG | INFO | WARNING | ERROR

# --- Capital de départ pour le paper trading ---
INITIAL_CAPITAL=10000.0

# --- Tickers par défaut (séparés par des virgules) ---
DEFAULT_TICKERS=AAPL,MSFT,SPY

# --- Période de données historiques ---
DATA_START_DATE=2020-01-01
DATA_END_DATE=2024-12-31

# --- Alpaca Paper Trading ---
# Créez un compte sur https://alpaca.markets et récupérez vos clés PAPER.
# ATTENTION : utilisez uniquement les clés Paper, jamais les clés Live.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# --- Sécurité live trading ---
# Doit rester à false. Mettre à true bloque le programme par sécurité.
LIVE_TRADING=false

# --- Bot temps réel ---
LIVE_TICKER=SPY           # Ticker surveillé par le bot
LIVE_INTERVAL_SEC=60      # Intervalle en secondes entre chaque vérification
LIVE_MA_SHORT=5           # Fenêtre MA courte (en barres de 1min)
LIVE_MA_LONG=20           # Fenêtre MA longue (en barres de 1min)

# --- Notifications (usage futur) ---
# TELEGRAM_BOT_TOKEN=your_bot_token
# TELEGRAM_CHAT_ID=your_chat_id
# DISCORD_WEBHOOK_URL=your_webhook_url

# --- Base de données (usage futur) ---
# DATABASE_URL=postgresql://user:password@localhost:5432/trading_db
